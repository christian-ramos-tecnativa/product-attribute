<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add configuration option to res.config.settings -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.allergen</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="product.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='product_barcodes']" position="after">
                <h2>Allergen Information</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="show_allergens_on_product_labels"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="show_allergens_on_product_labels"/>
                            <div class="text-muted">
                                Display allergen icons at the bottom of product labels
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
